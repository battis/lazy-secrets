    "@prettier/plugin-xml": "^3.4.2",
    "@tsconfig/node-lts": "^24.0.0",
    "commit-and-tag-version": "^12.7.3",
    "del-cli": "^7.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "prettier-plugin-ejs": "^1.0.3",
